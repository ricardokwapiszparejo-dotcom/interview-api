meta {
  name: Create Overlapping Audit (409)
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/audits
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "fechaHora": "2027-03-10T10:30:00",
    "cliente": "other-client@example.com",
    "tecnico": "Ana Ruiz"
  }
}

docs {
  Same technician, 10:30-11:30 vs the 10:00-11:00 audit created before: expects 409.
  Change tecnico AND cliente (or move to 11:00, exclusive boundary) to get a 201.
}
