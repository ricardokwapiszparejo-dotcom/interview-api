meta {
  name: Create Next Audit (same technician)
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/audits
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "cliente": "other-client@example.com",
    "tecnico": "Ana Ruiz"
  }
}

docs {
  Same technician as the previous request: the server chains it back to back,
  one hour after the first audit. A different technician AND client would get
  the same slot in parallel instead.
}
