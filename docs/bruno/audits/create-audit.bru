meta {
  name: Create Audit
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/audits
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "cliente": "acme@example.com",
    "tecnico": "Ana Ruiz"
  }
}

script:post-response {
  if (res.body.id) {
    bru.setEnvVar("auditId", res.body.id);
  }
}

docs {
  Creates an audit in PENDIENTE state at the first free slot for the
  technician/client (fechaHora is assigned by the server and not accepted in the body).
  201 with the created resource; 400 if a field is missing or fechaHora/estado is sent.
  The returned id is saved to {{auditId}} for the next requests.
}
