meta {
  name: Update Audit
  type: http
  seq: 6
}

put {
  url: {{baseUrl}}/audits/{{auditId}}
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "fechaHora": "2027-03-10T12:00:00",
