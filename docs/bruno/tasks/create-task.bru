meta {
  name: Create Task
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/tasks
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "title": "Buy milk"
  }
}

script:post-response {
  if (res.body.id) {
    bru.setEnvVar("taskId", res.body.id);
  }
}

docs {
  Creates a task. 201 with the created resource; 400 if title is missing.
  The returned id is saved to {{taskId}} for the next requests.
}
